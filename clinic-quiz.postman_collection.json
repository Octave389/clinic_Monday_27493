{
  "info": {
    "name": "Clinic Management - Queries",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:1014" },
    { "key": "doctorId", "value": "4c376bb6-0c7e-4554-8a0b-0317e8f31829" },
    { "key": "officeId", "value": "41c01f78-0bfd-4019-96a9-155d7f50f6e3" }
  ],
  "item": [
    {
      "name": "A1 Patients by last name (uwase)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=uwase",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "by-last-name"],
          "query": [{ "key": "lastName", "value": "uwase" }]
        }
      }
    },
    {
      "name": "A1 Patients by last name (UWASE - case test)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=UWASE",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "by-last-name"],
          "query": [{ "key": "lastName", "value": "UWASE" }]
        }
      }
    },
    {
      "name": "A1 Patients by last name (no match -> [])",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=Smith",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "by-last-name"],
          "query": [{ "key": "lastName", "value": "Smith" }]
        }
      }
    },
    {
      "name": "A2 Appointments by status (SCHEDULED)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "by-status"],
          "query": [{ "key": "status", "value": "SCHEDULED" }]
        }
      }
    },
    {
      "name": "A2 Appointments by status (invalid -> 400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/by-status?status=WRONG",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "by-status"],
          "query": [{ "key": "status", "value": "WRONG" }]
        }
      }
    },
    {
      "name": "A3 Appointments between dates",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "between"],
          "query": [
            { "key": "start", "value": "2026-10-01" },
            { "key": "end", "value": "2026-10-31" }
          ]
        }
      }
    },
    {
      "name": "A3 Appointments between (bad date -> 400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/between?start=abc&end=2026-10-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "between"],
          "query": [
            { "key": "start", "value": "abc" },
            { "key": "end", "value": "2026-10-31" }
          ]
        }
      }
    },
    {
      "name": "A4 Save appointment (doctor already booked that date -> 409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient\": { \"id\": \"32394660-3043-45c0-90dd-a391674dbede\" },\n  \"doctor\": { \"id\": \"{{doctorId}}\" },\n  \"appointmentDate\": \"2026-10-20T15:00:00\",\n  \"reason\": \"Checkup\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/appointments/save",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "save"]
        }
      }
    },
    {
      "name": "Setup - List doctors (to get an id)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/doctor/all",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctor", "all"]
        }
      }
    },
    {
      "name": "B1 Doctors by specialization (cardiology)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/doctors/by-specialization?name=cardiology",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctors", "by-specialization"],
          "query": [{ "key": "name", "value": "cardiology" }]
        }
      }
    },
    {
      "name": "B1 Doctors by specialization (CARDIOLOGY - case test)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/doctors/by-specialization?name=CARDIOLOGY",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctors", "by-specialization"],
          "query": [{ "key": "name", "value": "CARDIOLOGY" }]
        }
      }
    },
    {
      "name": "B2 Doctors without an office",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/doctors/without-office",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctors", "without-office"]
        }
      }
    },
    {
      "name": "B3 Specializations nobody offers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/specializations/unused",
          "host": ["{{baseUrl}}"],
          "path": ["api", "specializations", "unused"]
        }
      }
    },
    {
      "name": "B4 Patients of a doctor",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/patients/of-doctor/{{doctorId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "of-doctor", "{{doctorId}}"]
        }
      }
    },
    {
      "name": "B4 Patients of a doctor (unknown id -> 404)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/patients/of-doctor/00000000-0000-0000-0000-000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "of-doctor", "00000000-0000-0000-0000-000000000000"]
        }
      }
    },
    {
      "name": "Setup - Give an office a name (for C3)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cardiology Wing\",\n  \"officeNumber\": \"101\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/offices/update/{{officeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "offices", "update", "{{officeId}}"]
        }
      }
    },
    {
      "name": "C1 Appointments per status",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/stats/by-status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "stats", "by-status"]
        }
      }
    },
    {
      "name": "C2 Frequent patients (min=3)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/patients/frequent?min=3",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "frequent"],
          "query": [{ "key": "min", "value": "3" }]
        }
      }
    },
    {
      "name": "C3 Busiest office",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/offices/busiest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "offices", "busiest"]
        }
      }
    },
    {
      "name": "C4 Doctor is absent (cancel a day)",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/cancel-day?doctorId={{doctorId}}&date=2026-10-20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "cancel-day"],
          "query": [
            { "key": "doctorId", "value": "{{doctorId}}" },
            { "key": "date", "value": "2026-10-20" }
          ]
        }
      }
    }
  ]
}
