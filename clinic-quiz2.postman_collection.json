{
  "info": {
    "name": "Clinic Management - Quiz 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:1014" },
    { "key": "aliceId", "value": "4c376bb6-0c7e-4554-8a0b-0317e8f31829" },
    { "key": "ericId", "value": "b101778f-9372-45c3-a827-903bc0a657a4" },
    { "key": "claireId", "value": "77b345b0-f876-4612-866e-681413c193f4" },
    { "key": "pediatricsId", "value": "9b3e266a-cf80-4d11-84b1-c229793f301b" },
    { "key": "dianeId", "value": "32394660-3043-45c0-90dd-a391674dbede" },
    { "key": "ssNumber", "value": "1001" },
    { "key": "olivierId", "value": "1b0c0854-cdad-43fe-99a9-b9025573d0c7" },
    { "key": "dianeAliceApptId", "value": "6ed1b0d5-8a04-4f34-8e18-be67ca449fc2" },
    { "key": "dianeEricApptId", "value": "3ae55b1a-dd7f-453e-aace-10bd7796eb77" },
    { "key": "dianeClaireApptId", "value": "b8072577-85cd-4e5b-ae9a-c1d837e958e3" },
    { "key": "olivierClaireApptId", "value": "e3781cc6-121a-442b-9dff-bdb862e32a4c" },
    { "key": "completedApptId", "value": "dea258ba-6db9-432f-a38b-168d80caf377" },
    { "key": "unknownId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "Step 0 - Data",
      "item": [
        {
          "name": "Create office 104 (stays free)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"officeNumber\": \"104\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/offices/save",
              "host": ["{{baseUrl}}"],
              "path": ["api", "offices", "save"]
            }
          }
        },
        {
          "name": "Give Diane her ss number (1001)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Diane\",\n  \"lastName\": \"Uwase\",\n  \"ssNumber\": \"{{ssNumber}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/patients/update/{{dianeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "update", "{{dianeId}}"]
            }
          }
        },
        {
          "name": "List patients (ss numbers)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/patients/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "all"]
            }
          }
        },
        {
          "name": "List doctors (ids, offices, specializations)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "all"]
            }
          }
        }
      ]
    },
    {
      "name": "Part A - Doctors and offices",
      "item": [
        {
          "name": "A1 Add Pediatrics to Eric (200)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{ericId}}/specializations/{{pediatricsId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{ericId}}", "specializations", "{{pediatricsId}}"]
            }
          }
        },
        {
          "name": "A1 Add it again (409)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{ericId}}/specializations/{{pediatricsId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{ericId}}", "specializations", "{{pediatricsId}}"]
            }
          }
        },
        {
          "name": "A1 Unknown doctor (404)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{unknownId}}/specializations/{{pediatricsId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{unknownId}}", "specializations", "{{pediatricsId}}"]
            }
          }
        },
        {
          "name": "A2 Remove Pediatrics from Eric (200)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{ericId}}/specializations/{{pediatricsId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{ericId}}", "specializations", "{{pediatricsId}}"]
            }
          }
        },
        {
          "name": "A2 Remove it again (409)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{ericId}}/specializations/{{pediatricsId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{ericId}}", "specializations", "{{pediatricsId}}"]
            }
          }
        },
        {
          "name": "A3 Free offices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/offices/free",
              "host": ["{{baseUrl}}"],
              "path": ["api", "offices", "free"]
            }
          }
        },
        {
          "name": "A4 Move Claire to 104 (200)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{claireId}}/office?officeNumber=104",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{claireId}}", "office"],
              "query": [{ "key": "officeNumber", "value": "104" }]
            }
          }
        },
        {
          "name": "A4 Move Claire back to 103 (200)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{claireId}}/office?officeNumber=103",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{claireId}}", "office"],
              "query": [{ "key": "officeNumber", "value": "103" }]
            }
          }
        },
        {
          "name": "A4 Office taken by Eric (409)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{aliceId}}/office?officeNumber=102",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{aliceId}}", "office"],
              "query": [{ "key": "officeNumber", "value": "102" }]
            }
          }
        },
        {
          "name": "A4 Unknown office number (404)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{aliceId}}/office?officeNumber=999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{aliceId}}", "office"],
              "query": [{ "key": "officeNumber", "value": "999" }]
            }
          }
        }
      ]
    },
    {
      "name": "Part B - Appointment rules",
      "item": [
        {
          "name": "B1 Date in the past (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": { \"id\": \"{{dianeId}}\" },\n  \"doctor\": { \"id\": \"{{ericId}}\" },\n  \"appointmentDate\": \"2026-10-01T10:00:00\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/save",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "save"]
            }
          }
        },
        {
          "name": "B1 Body status is ignored, saved as SCHEDULED (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": { \"id\": \"{{olivierId}}\" },\n  \"doctor\": { \"id\": \"{{ericId}}\" },\n  \"appointmentDate\": \"2026-10-28T09:00:00\",\n  \"status\": \"COMPLETED\",\n  \"reason\": \"Skin check\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/save",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "save"]
            }
          }
        },
        {
          "name": "B2 SCHEDULED -> CONFIRMED (200)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{olivierClaireApptId}}/status?status=CONFIRMED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{olivierClaireApptId}}", "status"],
              "query": [{ "key": "status", "value": "CONFIRMED" }]
            }
          }
        },
        {
          "name": "B2 CONFIRMED -> SCHEDULED (400)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{olivierClaireApptId}}/status?status=SCHEDULED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{olivierClaireApptId}}", "status"],
              "query": [{ "key": "status", "value": "SCHEDULED" }]
            }
          }
        },
        {
          "name": "B2 COMPLETED -> SCHEDULED (400)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{completedApptId}}/status?status=SCHEDULED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{completedApptId}}", "status"],
              "query": [{ "key": "status", "value": "SCHEDULED" }]
            }
          }
        },
        {
          "name": "B2 Unknown appointment (404)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{unknownId}}/status?status=CONFIRMED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{unknownId}}", "status"],
              "query": [{ "key": "status", "value": "CONFIRMED" }]
            }
          }
        },
        {
          "name": "B3 Reschedule Diane's 10-22 to 10-30 (200)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{dianeEricApptId}}/reschedule?newDate=2026-10-30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{dianeEricApptId}}", "reschedule"],
              "query": [{ "key": "newDate", "value": "2026-10-30" }]
            }
          }
        },
        {
          "name": "B3 Doctor already booked that date (409)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{dianeClaireApptId}}/reschedule?newDate=2026-11-05",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{dianeClaireApptId}}", "reschedule"],
              "query": [{ "key": "newDate", "value": "2026-11-05" }]
            }
          }
        },
        {
          "name": "B3 COMPLETED cannot be rescheduled (400)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{completedApptId}}/reschedule?newDate=2026-10-30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{completedApptId}}", "reschedule"],
              "query": [{ "key": "newDate", "value": "2026-10-30" }]
            }
          }
        },
        {
          "name": "B3 New date in the past (400)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{dianeAliceApptId}}/reschedule?newDate=2026-10-01",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{dianeAliceApptId}}", "reschedule"],
              "query": [{ "key": "newDate", "value": "2026-10-01" }]
            }
          }
        },
        {
          "name": "B3 Unknown appointment (404)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{unknownId}}/reschedule?newDate=2026-10-30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{unknownId}}", "reschedule"],
              "query": [{ "key": "newDate", "value": "2026-10-30" }]
            }
          }
        },
        {
          "name": "B3 Move Diane's appointment back to 10-22 (200)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{dianeEricApptId}}/reschedule?newDate=2026-10-22",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{dianeEricApptId}}", "reschedule"],
              "query": [{ "key": "newDate", "value": "2026-10-22" }]
            }
          }
        }
      ]
    }
  ]
}
