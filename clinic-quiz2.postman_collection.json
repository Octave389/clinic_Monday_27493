        {
          "name": "C2 Prescriptions of Jean's appointment (saves newest id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// keep the newest prescription's id for the C4 requests",
                  "const list = pm.response.json();",
                  "if (Array.isArray(list) && list.length) {",
                  "    list.sort((a, b) => a.createdAt.localeCompare(b.createdAt));",
                  "    pm.collectionVariables.set('prescriptionId', list[list.length - 1].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
